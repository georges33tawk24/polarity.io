; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/app_id="ca-app-pub-5934305986842564~9127042367"

[application]

config/name="Polarity.io"
config/description="One-thumb magnet combat arena."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
boot_splash/bg_color=Color(0.055, 0.06, 0.09, 1)
boot_splash/show_image=false
config/icon="res://store/icons/icon_512.png"

[autoload]

Bus="*res://scripts/bus.gd"
Platform="*res://scripts/platform.gd"
Audio="*res://scripts/audio.gd"
Game="*res://scripts/game.gd"
Meta="*res://scripts/meta.gd"
Config="*res://scripts/remote_config.gd"
Analytics="*res://scripts/analytics.gd"
Ads="*res://scripts/ads.gd"
Store="*res://scripts/store.gd"
Backend="*res://scripts/backend.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[input_devices]

; Explicit, not left to the engine default. Control/Button only listen for MOUSE
; events, so with this off every button in the game is dead on a phone — the bug
; that shipped in an IPA (§12s). Godot omits settings that match the default when
; it rewrites this file, so it has silently disappeared from here once already.
pointing/emulate_mouse_from_touch=true

[internationalization]

locale/translations=PackedStringArray("res://data/i18n/strings.en.translation", "res://data/i18n/strings.es.translation", "res://data/i18n/strings.pt_BR.translation", "res://data/i18n/strings.fr.translation", "res://data/i18n/strings.de.translation", "res://data/i18n/strings.ru.translation", "res://data/i18n/strings.tr.translation", "res://data/i18n/strings.id.translation", "res://data/i18n/strings.ja.translation", "res://data/i18n/strings.ko.translation")

[physics]

3d/default_gravity=0.0

[rendering]

renderer/rendering_method="mobile"
; Android drops to the compatibility (GLES3) renderer. The Vulkan "mobile"
; backend is faster on hardware with a good driver and catastrophic on hardware
; without one — this build ran the MENU at about 2fps on a real Samsung, which is
; not a scene-complexity number, it is a driver number. Compatibility is the
; standard remedy and the same backend the web build already uses.
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
environment/defaults/default_clear_color=Color(0.055, 0.06, 0.09, 1)
; MSAA off. On a phone it costs real milliseconds per frame for an edge quality
; nobody can see at that pixel density, and this build was measured at ~2fps on a
; device.
anti_aliasing/quality/msaa_3d=0
