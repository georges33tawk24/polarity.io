; POLARITY — Godot 4.3 project.
; Input map, audio buses and window handling are configured in code
; (scripts/platform.gd) so there are no fragile hand-authored config blobs.

config_version=5

[application]

config/name="POLARITY"
config/description="One-thumb magnet combat arena."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://store/icons/icon_512.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.055, 0.06, 0.09, 1)

[autoload]

; Order matters: Game applies saved volumes on boot, so Audio's buses must exist first.
Bus="*res://scripts/bus.gd"
Platform="*res://scripts/platform.gd"
Audio="*res://scripts/audio.gd"
Game="*res://scripts/game.gd"
Meta="*res://scripts/meta.gd"
Config="*res://scripts/remote_config.gd"
Analytics="*res://scripts/analytics.gd"
Ads="*res://scripts/ads.gd"
Store="*res://scripts/store.gd"
Backend="*res://scripts/backend.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[internationalization]

locale/translations=PackedStringArray("res://data/i18n/strings.en.translation", "res://data/i18n/strings.es.translation", "res://data/i18n/strings.pt_BR.translation", "res://data/i18n/strings.fr.translation", "res://data/i18n/strings.de.translation", "res://data/i18n/strings.ru.translation", "res://data/i18n/strings.tr.translation", "res://data/i18n/strings.id.translation", "res://data/i18n/strings.ja.translation", "res://data/i18n/strings.ko.translation")
locale/fallback="en"

[input_devices]

; Intent handles touch and mouse separately; emulation would double-fire a hold.
pointing/emulate_mouse_from_touch=false

[physics]

3d/default_gravity=0.0
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
environment/defaults/default_clear_color=Color(0.055, 0.06, 0.09, 1)
